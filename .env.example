# Copy to .env (gitignored). Only the API key is required for live vision extraction.
ANTHROPIC_API_KEY=
# Optional overrides (defaults shown)
LINDA_BASE_URL=http://127.0.0.1:8000
LINDA_USERNAME=agent.demo
LINDA_PASSWORD=demo-password-123
LINDA_VISION_MODEL=claude-opus-5-5
# vision | replay   (replay = use committed extraction cache only, no API calls)
LINDA_OCR_MODE=vision
